  "events": [
    {
      "trigger": "on_start",
      "param": null,
      "mode": "blocking",
      "once": true,
      "script": "司仪: 这一场，舞台上会同时出现三个方块。\n司仪: 最新那块跟着你走，另外两块会停在它们出现的那一列继续倒计时。\n司仪: 想让它们错开站位的诀窍——趁新块还在瞄准，把它引到你要的列。"
    },
    {
      "trigger": "on_lock_count",
      "param": 5,
      "mode": "ambient",
      "once": true,
      "script": "司仪: 五块了，节奏会越来越快。 \\ sfx alarm 0.6"
    },
    {
      "trigger": "on_row",
      "param": 10,
      "mode": "ambient",
      "once": true,
      "script": "司仪: 过半了。 \\ sfx coin"
    },
    {
      "trigger": "on_win",
      "param": null,
      "mode": "blocking",
      "once": true,
      "script": "司仪: 三块齐飞都没砸到你，漂亮。"
    },
    {
      "trigger": "on_lose",
      "param": null,
      "mode": "ambient",
      "once": true,
      "script": "司仪: 别急，看清楚哪块先落。"
    }
  ],
