    {
      "trigger": "on_start",
      "param": null,
      "mode": "blocking",
      "once": true,
      "script": "司仪: 这一场演示两件事——自定义形状，和自定义事件。\n司仪: 方块池里有「十字」和「阶梯」，都是手画的形状。\n司仪: 按 X 还能旋转它们；固化之后就再也改不动了。"
    },
    {
      "trigger": "on_time",
      "param": 6,
      "mode": "ambient",
      "once": true,
      "script": "司仪: 六秒到了，剧本直接往 4 号位丢一块十字。 \\ drop cross 4 \\ sfx chime"
    },
    {
      "trigger": "on_lock_count",
      "param": 3,
      "mode": "ambient",
      "once": true,
      "script": "司仪: 三块了。\\ sfx tick"
    },
    {
      "trigger": "on_row",
      "param": 8,
      "mode": "ambient",
      "once": true,
      "script": "司仪: 已经爬到第八行。 \\ sfx coin"
    },
    {
      "trigger": "on_key",
      "param": "x",
      "mode": "ambient",
      "once": true,
      "script": "司仪: 转得不错。"
    },
    {
      "trigger": "on_win",
      "param": null,
      "mode": "blocking",
      "once": true,
      "script": "司仪: 登顶，收工。"
    },
    {
      "trigger": "on_lose",
      "param": null,
      "mode": "ambient",
      "once": true,
      "script": "司仪: 再来一遍就是了。"
    }
